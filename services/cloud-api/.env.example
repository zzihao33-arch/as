NODE_ENV=production
PORT=8080
HOST=127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cmhub
MYSQL_USER=cmhub_api
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
REDIS_URL=redis://127.0.0.1:6379/0
JSON_BODY_LIMIT=256kb
# Only POST /api/v1/inbound-batches uses this larger authenticated limit.
INBOUND_BATCH_JSON_LIMIT=10mb
# Only POST /api/v1/label-pushes (TYG v1.1) uses this Base64 JSON limit.
TYG_LABEL_PUSH_JSON_LIMIT=7mb
LABEL_PDF_LIMIT=20mb
# Use filesystem for local development, cos for shared test/production storage.
LABEL_STORAGE_BACKEND=filesystem
LABEL_STORAGE_ROOT=/var/lib/cmhub/labels
# Required when LABEL_STORAGE_BACKEND=cos. Use a least-privileged CAM credential.
# COS_BUCKET=cmhub-labels-prod-1476409815
# COS_REGION=na-ashburn
# COS_PREFIX=test
# COS_SECRET_ID=REPLACE_WITH_CAM_SECRET_ID
# COS_SECRET_KEY=REPLACE_WITH_CAM_SECRET_KEY
# COS_SECURITY_TOKEN=
WAREHOUSE_ALLOWED_ORIGINS=https://cmhubtool.com
WAREHOUSE_SESSION_HOURS=8
OUTBOUND_WEBHOOK_ENABLED=false
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Store this only in the server secret manager/environment. Never reuse a client signing secret here.
# OUTBOUND_WEBHOOK_MASTER_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
# During rotation, configure every required version instead: v1=<base64>,v2=<base64>
# OUTBOUND_WEBHOOK_MASTER_KEYS=v1=REPLACE_OLD_KEY,v2=REPLACE_NEW_KEY
OUTBOUND_WEBHOOK_KEY_VERSION=v1
OUTBOUND_WEBHOOK_POLL_INTERVAL_MS=5000
OUTBOUND_WEBHOOK_BATCH_SIZE=20
OUTBOUND_WEBHOOK_LEASE_SECONDS=60
OUTBOUND_WEBHOOK_TIMEOUT_MS=10000
OUTBOUND_WEBHOOK_MAX_ATTEMPTS=12
